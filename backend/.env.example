APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=app
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DOCTRINE_PROXY_AUTOGENERATE=true
# Mock partner logins (config/partners.php). Optional: leave unset to use the
# defaults demo-partner-token and other-partner-token. Each must be non-empty and unique.
# To choose which partner the portal acts as, set NUXT_PARTNER_TOKEN in frontend/.env.
# PARTNER_DEMO_TOKEN=demo-partner-token
# PARTNER_OTHER_TOKEN=other-partner-token

# Structured JSON logs: one file per channel in storage/logs by default.
# In containers set LOG_STREAM=php://stdout so the platform collects all channels.
LOG_STREAM=
LOG_SLOW_QUERY_MS=200

# Personal data encryption (README, Decisions). "local" derives dev keys from
# APP_KEY and is refused in production; production uses "cloud_kms".
PII_KEY_DRIVER=local
PII_LOCAL_KEYS=
PII_LOCAL_INDEX_KEY=
PII_KMS_KEY_NAME=
PII_KMS_WRAPPED_KEYS=
PII_KMS_WRAPPED_INDEX_KEY=

# The partner portal (Nuxt). Opening this API's root URL redirects there.
FRONTEND_URL=http://localhost:3000
NUXT_PARTNER_TOKEN=demo-partner-token
#NUXT_PARTNER_TOKEN=partner-demo